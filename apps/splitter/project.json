{
  "name": "splitter",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/splitter/src",
  "targets": {
    "build": {
      "cache": true,
      "executor": "@monodon/rust:build",
      "outputs": ["{options.target-dir}"],
      "options": {
        "target-dir": "dist/target/splitter"
      },
      "configurations": {
        "production": {
          "release": true
        }
      }
    },
    "build-wasm": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/splitter",
        "command": "wasm-pack build --target nodejs --out-dir ../../packages/vite-material-symbols/src/font"
      }
    },
    "lint": {
      "cache": true,
      "executor": "@monodon/rust:lint",
      "outputs": ["{options.target-dir}"],
      "options": {
        "target-dir": "dist/target/splitter"
      }
    },
    "run": {
      "executor": "@monodon/rust:run",
      "outputs": ["{options.target-dir}"],
      "options": {
        "target-dir": "dist/target/splitter"
      },
      "configurations": {
        "production": {
          "release": true
        }
      }
    },
    "generate-ts": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/splitter/utils",
        "command": "npx tsx generate-definitions.ts"
      }
    }
  },
  "tags": []
}
